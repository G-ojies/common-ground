# Groq (LLM). Leave empty to get a deterministic, non-LLM plan.
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Qloo Taste AI (server-side only, never exposed to the browser).
# Leave QLOO_API_KEY empty to run on the built-in fake mock dataset.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Set to 1 to force mock mode even when a key is present.
QLOO_MOCK=
